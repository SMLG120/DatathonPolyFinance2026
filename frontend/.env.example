# Before You Buy — frontend build-time configuration.
#
# Only NON-SECRET values belong here. Anything prefixed NEXT_PUBLIC_ is inlined
# into the JavaScript bundle and is readable by every visitor.
#
# Base URL of the deployed HTTP API (API Gateway), without a trailing slash.
# Leave it empty to build a site that runs entirely on the typed test fixtures
# ("fixtures mode"); the interface then shows a "Test data — fixtures" label.
NEXT_PUBLIC_API_BASE_URL=

# There is deliberately no variable for the demo access code. It is typed by
# the user at runtime and kept in sessionStorage only (LEAD_DECISIONS D8).
