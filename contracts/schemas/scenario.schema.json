{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://before-you-buy.invalid/contracts/schemas/scenario.schema.json",
  "title": "scenario",
  "description": "A fictional persona scenario (contracts/scenarios/*.json). Persona facts come from the official case and carry a page reference. The portfolio, the objective wording, every threshold and every scripted request are INVENTED by the team and flagged as such (LEAD_DECISIONS D7): the case gives the personas no numbers. Semantic rules (byb_contracts.validate_scenario): portfolio.persona_id == persona.persona_id; every scenario rule and alternative rule has status PROPOSED, origin FICTIONAL_SCENARIO and a number; rule objective links resolve; demo requests name instruments.",
  "type": "object",
  "required": ["schema_version", "fictional", "fiction_notice", "persona", "portfolio", "objectives", "scenario_rules", "alternative_rule_sets", "demo_phrases", "demo_requests", "demo_challenge", "demo_steps"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "fictional": { "const": true },
    "fiction_notice": { "$ref": "common.schema.json#/$defs/non_empty_string" },
    "persona": {
      "type": "object",
      "required": ["persona_id", "display_name", "case_reference", "facts", "what_this_persona_tests"],
      "additionalProperties": false,
      "properties": {
        "persona_id": { "$ref": "common.schema.json#/$defs/persona_id" },
        "display_name": { "$ref": "common.schema.json#/$defs/non_empty_string" },
        "case_reference": { "$ref": "common.schema.json#/$defs/non_empty_string", "description": "e.g. 'Case p.7'." },
        "facts": {
          "type": "array", "minItems": 1,
          "items": { "type": "object", "required": ["fact_id", "label", "text", "case_reference"], "additionalProperties": false,
            "properties": {
              "fact_id": { "$ref": "common.schema.json#/$defs/id" },
              "label": { "$ref": "common.schema.json#/$defs/non_empty_string" },
              "text": { "$ref": "common.schema.json#/$defs/non_empty_string", "description": "Wording of the official case." },
              "case_reference": { "$ref": "common.schema.json#/$defs/non_empty_string" }
            } }
        },
        "what_this_persona_tests": {
          "type": "object", "required": ["text", "case_reference"], "additionalProperties": false,
          "properties": { "text": { "$ref": "common.schema.json#/$defs/non_empty_string" }, "case_reference": { "$ref": "common.schema.json#/$defs/non_empty_string" } }
        }
      }
    },
    "portfolio": { "$ref": "portfolio.schema.json" },
    "objectives": { "type": "array", "minItems": 1, "items": { "$ref": "objective.schema.json" } },
    "scenario_rules": { "type": "array", "items": { "$ref": "rule.schema.json" }, "description": "Rules OFFERED for confirmation. Inactive until the user confirms them." },
    "alternative_rule_sets": {
      "type": "array",
      "items": { "type": "object", "required": ["set_id", "label", "purpose", "rules"], "additionalProperties": false,
        "properties": {
          "set_id": { "$ref": "common.schema.json#/$defs/id" },
          "label": { "$ref": "common.schema.json#/$defs/non_empty_string" },
          "purpose": { "$ref": "common.schema.json#/$defs/non_empty_string" },
          "rules": { "type": "array", "minItems": 1, "items": { "$ref": "rule.schema.json" } }
        } }
    },
    "demo_phrases": {
      "type": "array",
      "items": { "type": "object", "required": ["phrase_id", "original_words", "expected_outcome", "note"], "additionalProperties": false,
        "properties": {
          "phrase_id": { "$ref": "common.schema.json#/$defs/id" },
          "original_words": { "$ref": "common.schema.json#/$defs/non_empty_string" },
          "expected_outcome": { "enum": ["CLARIFICATION", "PROPOSED_RULES", "UNSUPPORTED"], "description": "What a correct interpreter does with the phrase. A targeted clarification is the correct outcome for ambiguous input." },
          "note": { "$ref": "common.schema.json#/$defs/non_empty_string" }
        } }
    },
    "demo_requests": {
      "type": "array",
      "items": { "type": "object", "required": ["request_id", "label", "purchase_request"], "additionalProperties": false,
        "properties": {
          "request_id": { "$ref": "common.schema.json#/$defs/id" },
          "label": { "$ref": "common.schema.json#/$defs/non_empty_string" },
          "purchase_request": { "$ref": "purchase_request.schema.json" }
        } }
    },
    "demo_challenge": {
      "anyOf": [{ "type": "null" }, {
        "type": "object", "required": ["label", "type", "payload"], "additionalProperties": false,
        "properties": {
          "label": { "$ref": "common.schema.json#/$defs/non_empty_string" },
          "type": { "$ref": "common.schema.json#/$defs/challenge_type" },
          "payload": { "type": "object" }
        }
      }]
    },
    "demo_steps": {
      "type": "array",
      "items": { "type": "object", "required": ["seq", "stage", "description"], "additionalProperties": false,
        "properties": { "seq": { "type": "integer", "minimum": 1 }, "stage": { "$ref": "common.schema.json#/$defs/ui_stage" }, "description": { "$ref": "common.schema.json#/$defs/non_empty_string" } } }
    }
  }
}
