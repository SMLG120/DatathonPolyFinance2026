{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://before-you-buy.invalid/contracts/schemas/common.schema.json",
  "title": "Common definitions (Before You Buy contracts)",
  "description": "Shared primitives and enumerations. Every quantity that is a share of the portfolio or of a fund is a FRACTION (10% = 0.10); there are no percentage fields anywhere. Convention: every property is required; an absent value is an explicit null.",
  "$defs": {
    "schema_version": { "const": "1.0.0", "description": "Version of these contracts. See contracts/README.md for the versioning rule." },
    "fraction": { "type": "number", "minimum": 0, "maximum": 1, "description": "Portfolio or fund fraction in [0, 1]." },
    "nullable_fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "signed_fraction": { "type": "number", "minimum": -1, "description": "Signed fraction, e.g. a return (-0.12 = a 12% loss) or a gap." },
    "nullable_signed_fraction": { "type": ["number", "null"], "minimum": -1 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$", "description": "Calendar date YYYY-MM-DD." },
    "nullable_date": { "type": ["string", "null"], "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
    "datetime": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$", "description": "UTC timestamp, ISO 8601 with a Z suffix." },
    "nullable_datetime": { "type": ["string", "null"], "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "description": "Opaque identifier (rule, objective, policy, evidence, job, challenge ...)." },
    "nullable_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "instrument_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,31}$", "description": "Ticker-style instrument id, e.g. NVDA, XIU.TO, BRK.B, BTC-USD." },
    "issuer_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,63}$", "description": "Company-level id shared by all share classes of one issuer, e.g. ALPHABET for GOOGL and GOOG. Funds and crypto assets use their own instrument_id." },
    "persona_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
    "source_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "nullable_source_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "non_empty_string": { "type": "string", "minLength": 1 },
    "nullable_string": { "type": ["string", "null"] },
    "currency": { "enum": ["CAD", "USD"] },
    "asset_class": { "enum": ["equity", "etf_equity", "etf_bond", "etf_commodity", "crypto"], "description": "Values of asset_class in the starter assets_universe.csv." },
    "funding": { "const": "CASH", "description": "The only supported funding path (LEAD_DECISIONS D5)." },
    "objective_kind": { "enum": ["goal", "preference", "constraint"] },
    "objective_source": { "enum": ["USER_STATED", "FICTIONAL_SCENARIO"] },
    "rule_type": { "enum": ["max_issuer_exposure", "min_issuer_exposure", "exclusion", "controversy_exclusion", "scenario_loss_budget"] },
    "rule_status": { "enum": ["PROPOSED", "CONFIRMED", "SUPERSEDED"] },
    "rule_origin": { "enum": ["USER_STATED", "FICTIONAL_SCENARIO", "SYSTEM_PROPOSED"] },
    "threshold_kind": { "enum": ["max_fraction", "min_fraction", "max_loss_fraction"] },
    "threshold_source": { "enum": ["USER_WORDS", "USER_ENTERED", "FICTIONAL_SCENARIO"] },
    "exclusion_definition_kind": { "enum": ["named_issuers", "fund_reported_sector"] },
    "scenario_id": { "enum": ["replay_2022"] },
    "controversy_nature": { "enum": ["ALLEGATION", "REGULATORY_FINDING", "COURT_RULING", "SETTLEMENT", "COMPANY_DISCLOSURE"] },
    "verdict_status": { "enum": ["PASS", "FAIL", "UNKNOWN"] },
    "execution_status": { "enum": ["OK", "INVALID_REQUEST", "ERROR"] },
    "execution_code": { "enum": ["TARGET_BELOW_CURRENT_WEIGHT", "TARGET_NEGATIVE", "TARGET_ABOVE_ONE", "UNSUPPORTED_INSTRUMENT", "INVALID_PORTFOLIO", "INVALID_POLICY", "ENGINE_ERROR"] },
    "feasibility_status": { "enum": ["FEASIBLE", "INSUFFICIENT_CASH"] },
    "consistency_status": { "enum": ["CONSISTENT", "PROVEN_CONFLICT", "NOT_ASSESSED"] },
    "conflict_type": { "enum": ["MIN_EXCEEDS_MAX_SAME_ISSUER"] },
    "coverage_status": { "enum": ["COVERED", "PARTIAL", "MISSING"] },
    "unknown_cause": { "enum": ["PARTIAL_HOLDINGS", "MISSING_HOLDINGS", "UNCLASSIFIED_SECTOR", "REGISTRY_ABSENCE", "INSUFFICIENT_HISTORY"] },
    "scenario_status": { "enum": ["COMPUTED", "INSUFFICIENT_HISTORY"] },
    "max_compliant_status": { "enum": ["SUPPORTED", "WITHHELD", "NO_FEASIBLE_PURCHASE"] },
    "binding_constraint_type": { "enum": ["RULE", "CASH"] },
    "headline": { "enum": ["ALL_PASS", "HAS_FAIL", "NO_FAIL_BUT_UNKNOWN", "INVALID_REQUEST", "POLICY_CONFLICT", "NO_RULES_EVALUATED", "EXECUTION_ERROR"] },
    "goal_context_type": { "enum": ["LINKED_RULE_RESULTS", "CONCENTRATION", "SCENARIO_DRAWDOWN", "NOT_QUANTIFIED"] },
    "evidence_label": { "enum": ["FACT", "ASSUMPTION", "FICTIONAL_SCENARIO", "CALCULATION"] },
    "evidence_unit": { "enum": ["fraction", "price", "fx_rate", "days", "count", "date", "text"] },
    "metric_id": {
      "enum": [
        "position_weight", "cash_weight", "cash_after_purchase",
        "fund_constituent_weight", "fund_coverage_fraction", "unattributed_fund_weight",
        "issuer_direct_exposure", "issuer_exposure_via_fund", "exposure_lower", "exposure_upper",
        "rule_threshold", "gap_to_limit",
        "scenario_instrument_return", "scenario_terminal_return", "scenario_max_drawdown", "scenario_loss",
        "price_adj_close", "fx_usdcad", "fx_rate_age_days", "price_age_days",
        "max_compliant_final_weight", "max_compliant_additional_purchase",
        "sector_label", "controversy_record", "holdings_date"
      ]
    },
    "subject_kind": { "enum": ["INSTRUMENT", "ISSUER", "FUND", "PORTFOLIO", "RULE", "FX"] },
    "portfolio_state": { "enum": ["STARTING", "PROPOSED", "NOT_APPLICABLE"] },
    "job_status": { "enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED"] },
    "tool_name": { "enum": ["get_portfolio", "get_policy", "get_holdings", "lookup_controversy_evidence", "simulate_change", "compute_exposure", "replay_period", "check_rules", "max_compliant_amount"] },
    "step_status": { "enum": ["RUNNING", "OK", "ERROR"] },
    "step_initiator": { "enum": ["MODEL", "SERVER"] },
    "agent_mode": { "enum": ["MODEL", "DETERMINISTIC_FALLBACK"] },
    "rendered_by": { "enum": ["TEMPLATE", "MODEL_VALIDATED"] },
    "failure_code": { "enum": ["DEADLINE_EXCEEDED", "WORKER_INVOCATION_FAILED", "WORKER_ERROR", "ENGINE_ERROR", "DATA_UNAVAILABLE"] },
    "challenge_type": { "enum": ["CORRECT_FACT", "CLARIFY_PREFERENCE", "CHANGE_RULE"] },
    "correction_status": { "enum": ["UNVERIFIED"] },
    "unsupported_code": { "enum": ["UNSUPPORTED_DEFINITION", "UNSUPPORTED_RULE_TYPE", "OUT_OF_SCOPE", "INSTRUCTION_IGNORED"] },
    "ui_stage": { "enum": ["PERSONA_PORTFOLIO", "GOALS_RULES", "PROPOSED_PURCHASE", "INVESTIGATION", "VERDICT_EVIDENCE", "CHALLENGE"] },
    "error_code": {
      "enum": [
        "UNAUTHORIZED", "VALIDATION_ERROR", "NOT_FOUND", "POLICY_VERSION_CONFLICT", "IDEMPOTENCY_KEY_REUSED",
        "INVESTIGATION_NOT_FINISHED", "INVESTIGATION_EXPIRED", "INVALID_PURCHASE_REQUEST", "INVALID_CONFIRMATION",
        "UNSUPPORTED_CHALLENGE", "INTERPRETER_TIMEOUT", "INTERPRETER_FAILED", "WORKER_INVOCATION_FAILED",
        "RATE_LIMITED", "INTERNAL_ERROR"
      ]
    },
    "bounds": {
      "type": "object",
      "description": "Interval for a measured quantity (LEAD_DECISIONS D4). lower <= upper. lower == upper when nothing is unknown.",
      "required": ["lower", "upper"],
      "additionalProperties": false,
      "properties": { "lower": { "type": "number" }, "upper": { "type": "number" } }
    },
    "nullable_bounds": { "anyOf": [{ "$ref": "#/$defs/bounds" }, { "type": "null" }] },
    "id_list": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "string_list": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
